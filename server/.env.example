# Copy to server/.env and fill in real values. NEVER commit the real .env.
# A strong random secret is required — the server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Port the API listens on (client dev server proxies /api here).
PORT=4000

# "development" or "production". In production the auth cookie is Secure.
NODE_ENV=development

# Absolute or relative path for the SQLite file (optional; defaults to ./data/sarmaya.sqlite)
# DB_PATH=./data/sarmaya.sqlite

# Hosted Turso (libSQL) database. REQUIRED on Vercel — a serverless function has no
# persistent disk, so the server refuses to start there without it. When set, it
# replaces the local file above. Get both from: turso db show --url <db> /
# turso db tokens create <db>
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# ---- LIVE AI COACH (all OPTIONAL) ----
# Without any of these the coach still works, answering from a deterministic,
# FACTS-grounded fallback (reply source: "fallback"). Configure one to get real,
# adaptive LLM replies (reply source: "llm"). Only a first name + computed FACTS
# are ever sent — never raw transactions, email, or account ids.
# Provider order: Anthropic first, then the OpenAI-compatible backend below.

# Preferred (paid): Anthropic. Also the preferred receipt scanner, and the ONLY
# one that can read a PDF.
# ANTHROPIC_API_KEY=sk-ant-...

# Receipt scanning can log the line it read the total from. That line is receipt
# content, so it stays off unless you turn it on to debug a wrong total.
# RECEIPT_SCAN_DEBUG=1

# FREE alternatives — any OpenAI-compatible /chat/completions endpoint:
#   • Local Ollama ($0, no signup, data stays on your machine):
#       install Ollama, run `ollama pull llama3.1`, then set:
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1
#   • Groq free tier (free API key, no card):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#     LLM_API_KEY=gsk_...
#
# Receipt scanning on the FREE route needs a model that can SEE. LLM_MODEL above
# is text-only (llama-3.3-70b-versatile cannot read an image), so the scanner uses
# its own setting and stays off until you name one. Reuses LLM_BASE_URL and
# LLM_API_KEY. Groq's vision model as documented — check their current model list,
# free-tier availability changes:
#     LLM_VISION_MODEL=qwen/qwen3.8-27b
# This path handles photos only; PDFs need ANTHROPIC_API_KEY.
